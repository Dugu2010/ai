{
  "name": "@dai/vercel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@dai/runtime": "workspace:*",
    "@vercel/sandbox": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^2.1.8"
  }
}
