# DAI — local/root example. The backend reads this; see apps/api/.env.example.
#
# Architecture: Vercel (Next.js frontend) -> Render (this API) -> Modal
# (Sandbox compute + persistent Volume workspace), with NVIDIA NIM as the model.

# Postgres — project/runtime metadata, conversations, settings
DATABASE_URL=postgresql://user:password@localhost:5432/dai

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=<generate-secure-secret>
JWT_ISSUER=dai-app
JWT_EXPIRATION_SECONDS=604800

# Encrypts user-supplied NIM keys at rest — generate with: openssl rand -hex 32
DAI_API_KEY_ENCRYPTION_KEY=<generate-encryption-key>

# NVIDIA NIM — the agent brain. Server-side only; never a NEXT_PUBLIC_* value.
NIM_API_KEY=<your-nvidia-api-key>
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=openai/gpt-oss-20b

# Modal — the execution runtime. Create at https://modal.com/settings/api-keys
# Both are required: the JS SDK authenticates with the id/secret pair.
MODAL_TOKEN_ID=<your-modal-token-id>
MODAL_TOKEN_SECRET=<your-modal-token-secret>

# Modal runtime tuning (all optional; defaults shown).
MODAL_APP_NAME=dai
MODAL_IMAGE_NAME=dai-runtime
MODAL_VOLUME_NAME=dai-workspaces
MODAL_CPU=1
MODAL_MEMORY_MIB=2048
MODAL_IDLE_TIMEOUT_MS=300000
MODAL_TIMEOUT_MS=14400000
MODAL_EXEC_TIMEOUT_MS=120000
MODAL_PREVIEW_PORTS=3000,5173,8080

PORT=3000
