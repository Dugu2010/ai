# Backend (Render) — apps/api
# All secrets live here. Vercel only needs NEXT_PUBLIC_API_URL (see below).

# Postgres — auto-set by Render when using render.yaml; else paste your connection string
DATABASE_URL=postgresql://user:password@host:5432/dai

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-chars
JWT_ISSUER=dai-app
JWT_EXPIRATION_SECONDS=604800

# Encryption for user NIM API keys — generate with: openssl rand -hex 32
DAI_API_KEY_ENCRYPTION_KEY=replace-with-64-hex-chars

# Note on CSRF: the API authenticates with a Bearer token only and never sets an
# auth cookie, so there is no ambient credential for a cross-site request to
# ride. There is therefore no CSRF_SECRET to configure. If cookie sessions are
# ever introduced, a CSRF secret becomes mandatory at that point.

# NVIDIA NIM (agent LLM)
NIM_API_KEY=nvapi-...
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-405b-instruct

# Modal — the execution runtime (Sandbox compute + persistent Volume workspace)
# Both tokens are required; the JS SDK authenticates with the id/secret pair.
# Get them at https://modal.com/settings/api-keys
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Tuning (optional; defaults shown). The workspace Volume holds every project's
# files under projects/<id> and outlives all Sandboxes, so idle timeouts only
# reclaim compute, never source code.
MODAL_APP_NAME=dai
MODAL_IMAGE_NAME=dai-runtime
MODAL_VOLUME_NAME=dai-workspaces
MODAL_CPU=1
MODAL_MEMORY_MIB=2048
MODAL_IDLE_TIMEOUT_MS=300000
MODAL_TIMEOUT_MS=14400000
MODAL_EXEC_TIMEOUT_MS=120000
MODAL_PREVIEW_PORTS=3000,5173,8080
# Optional egress lockdown: comma-separated domains, or true to block all.
# MODAL_OUTBOUND_DOMAIN_ALLOWLIST=registry.npmjs.org,pypi.org
# MODAL_BLOCK_NETWORK=false

# Agent runtime budgets. These exist so a run cannot silently keep paying for
# compute; when one is hit the agent degrades and says so rather than continuing.
MAX_RUNTIME_ACTIVATIONS_PER_AGENT_RUN=1
MAX_EXEC_CALLS_PER_AGENT_RUN=40
MAX_RUNTIME_SECONDS_PER_AGENT_RUN=600
MAX_COMMAND_TIMEOUT=300000
MAX_AGENT_ITERATIONS=12

# Per-project storage ceiling, enforced by DAI. Modal has no per-project quota
# (a Volume is one namespace with a 500k inode limit and no stated storage cap),
# so DAI measures each project's subPath and refuses to grow it past this.
MAX_PROJECT_WORKSPACE_BYTES=53687091200
# Files at or above this size are not stored in a checkpoint, so undo reports
# them as non-reversible instead of partially restoring a run.
MAX_CHECKPOINT_FILE_BYTES=524288

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://ai-web-git-master-wither2.vercel.app,https://ai-web-wither2.vercel.app

PORT=3000
