# Backend (Render) — apps/api
# All secrets live here. Vercel only needs NEXT_PUBLIC_API_URL (see below).

# Postgres — auto-set by Render when using render.yaml; else paste your connection string
DATABASE_URL=postgresql://user:password@host:5432/dai

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-chars
JWT_ISSUER=dai-app
JWT_EXPIRATION_SECONDS=604800

# Encryption for user NIM API keys — generate with: openssl rand -hex 32
DAI_API_KEY_ENCRYPTION_KEY=replace-with-64-hex-chars

# Note on CSRF: the API authenticates with a Bearer token only and never sets an
# auth cookie, so there is no ambient credential for a cross-site request to
# ride. There is therefore no CSRF_SECRET to configure. If cookie sessions are
# ever introduced, a CSRF secret becomes mandatory at that point.

# NVIDIA NIM (agent LLM)
NIM_API_KEY=nvapi-...
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-405b-instruct

# Modal — the execution runtime (Sandbox compute + persistent Volume workspace)
# --- Legacy Modal runtime (migration source only) ----------------------------
# Retained so scripts/migrate-runtime-v2.ts can read old workspaces out of the
# Modal Volume. Nothing new runs here once RUNTIME_PROVIDER=vercel.
# Both tokens are required; the JS SDK authenticates with the id/secret pair.
# Get them at https://modal.com/settings/api-keys
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=dai
MODAL_IMAGE_NAME=dai-runtime
MODAL_VOLUME_NAME=dai-workspaces

# Agent runtime budgets. These exist so a run cannot silently keep paying for
# compute; when one is hit the agent degrades and says so rather than continuing.
# The two ceilings are different currencies: commands spend Active CPU, which is
# the scarce monthly quantity, while file operations only hold the machine awake.
MAX_RUNTIME_ACTIVATIONS_PER_AGENT_RUN=1
MAX_EXEC_CALLS_PER_AGENT_RUN=40
MAX_FILE_OPS_PER_AGENT_RUN=600
MAX_RUNTIME_SECONDS_PER_AGENT_RUN=600
MAX_COMMAND_TIMEOUT=300000
MAX_AGENT_ITERATIONS=12

# Per-project storage ceiling, enforced by DAI. A Vercel drive is created with a
# cap, but the mirrored bytes and the snapshots are the quantities that actually
# accumulate, so DAI measures the project and refuses to grow it past this.
MAX_PROJECT_WORKSPACE_BYTES=53687091200
# Files at or above this size are not stored in a checkpoint, so undo reports
# them as non-reversible instead of partially restoring a run.
MAX_CHECKPOINT_FILE_BYTES=524288

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://ai-web-git-master-wither2.vercel.app,https://ai-web-wither2.vercel.app

PORT=3000

# --- Execution runtime -------------------------------------------------------
# Which provider runs agent code: "vercel" (current, the default) or "modal"
# (legacy, kept only for deployments that still hold workspaces in the Modal
# Volume — run scripts/migrate-runtime-v2.ts before removing it).
RUNTIME_PROVIDER=vercel

# Vercel Sandbox. A project-scoped token is enough; OIDC works in Vercel deploys.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_SANDBOX_IMAGE=vercel/sandbox/node:22
VERCEL_SANDBOX_REGION=iad1
VERCEL_PREVIEW_PORTS=3000
# Deterministic names, because a resume is addressed by name. Changing either
# one orphans every existing project's machine and drive.
VERCEL_SANDBOX_NAME_PREFIX=dai
VERCEL_DRIVE_PREFIX=dai-workspace
# A session is short on purpose: an awake VM bills provisioned memory whether or
# not it is working, and resuming from the last snapshot is cheap.
VERCEL_SANDBOX_SESSION_TIMEOUT_MS=900000
VERCEL_SANDBOX_EXEC_TIMEOUT_MS=120000
VERCEL_DEV_SERVER_READY_TIMEOUT_MS=60000
VERCEL_SANDBOX_MAX_VCPUS=4
# Snapshots count against a small lifetime storage allowance, so only the latest
# is kept and it is dropped after a week.
VERCEL_SNAPSHOT_KEEP_LAST=1
VERCEL_SNAPSHOT_EXPIRATION_MS=604800000
# Shared read-only drive holding package-manager caches; empty disables it.
# Populate it with acquireCacheWriter() (see VERCEL_RUNTIME_MIGRATION.md).
VERCEL_CACHE_DRIVE=
VERCEL_CACHE_PATH=/dai-cache
# The API's own public origin, used to make proxied preview URLs absolute.
PUBLIC_API_URL=

# Cloudflare R2, the workspace mirror that answers cold reads.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ROOT_PREFIX=workspaces

# Monthly ceilings, enforced before booting a sandbox. Defaults match Vercel
# Hobby; on the free tier a breach suspends sandbox creation for 30 days, so the
# app stops itself short of the real number.
MONTHLY_ACTIVE_CPU_MS=18000000
MONTHLY_PROVISIONED_GB_HOURS=420
MONTHLY_SANDBOX_CREATIONS=5000
MONTHLY_EGRESS_BYTES=21474836480
# Tell the user at 60%, switch off previews and escalation at 80%, refuse new
# sandboxes at 95%.
QUOTA_WARN_FRACTION=0.6
QUOTA_THROTTLE_FRACTION=0.8
QUOTA_HALT_FRACTION=0.95
