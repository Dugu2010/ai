{
  "name": "dai",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "bun run build:packages && bun run build:web",
    "build:packages": "bun run build:types && bun run build:db && bun run build:freestyle && bun run build:nim && bun run build:ui",
    "build:web": "cd apps/web && bun run build",
    "dev": "bun run dev:web",
    "typecheck": "bun run typecheck:types && bun run typecheck:db && bun run typecheck:freestyle && bun run typecheck:nim && bun run typecheck:ui && bun run typecheck:web",
    "lint": "bun run lint:web",
    "build:types": "cd packages/types && bun run build",
    "build:db": "cd packages/db && bun run build",
    "build:freestyle": "cd packages/freestyle && bun run build",
    "build:nim": "cd packages/nim && bun run build",
    "build:ui": "cd packages/ui && bun run build",
    "dev:web": "cd apps/web && bun run dev",
    "typecheck:types": "cd packages/types && bun run typecheck",
    "typecheck:db": "cd packages/db && bun run typecheck",
    "typecheck:freestyle": "cd packages/freestyle && bun run typecheck",
    "typecheck:nim": "cd packages/nim && bun run typecheck",
    "typecheck:ui": "cd packages/ui && bun run typecheck",
    "typecheck:web": "cd apps/web && bun run typecheck",
    "lint:web": "cd apps/web && bun run lint"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.2.0",
    "eslint": "^9.17.0",
    "prettier": "^3.3.3",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.0",
    "dotenv": "^16.4.5"
  },
  "engines": { "node": ">=20" }
}
